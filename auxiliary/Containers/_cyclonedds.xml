<CycloneDDS>
  <Domain>
    <General>
      <Interfaces>
        <NetworkInterface
          name="{CYCLONEDDS_INTERFACE}"
          priority="default"
          multicast="default"
        />
      </Interfaces>
      <AllowMulticast>spdp</AllowMulticast>
    </General>
    <Compatibility>
      <StandardsConformance>lax</StandardsConformance>
      <ExplicitlyPublishQosSetToDefault>true</ExplicitlyPublishQosSetToDefault>
    </Compatibility>
  </Domain>
</CycloneDDS>
